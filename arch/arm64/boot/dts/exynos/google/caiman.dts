/*
 * Google Pixel 9 Pro (caiman) board device tree
 *
 * Copyright 2026 Will
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "zumapro.dtsi"

/ {
	model = "Google Pixel 9 Pro (caiman)";
	compatible = "google,caiman", "google,zumapro";

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x80000000>;
	};

	ufs_0_fixed_vcc_reg: regulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		enable-active-high;
	};
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};
