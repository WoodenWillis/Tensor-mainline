/*
 * Google Pixel 9 Pro (caiman) board device tree
 *
 * Copyright 2026 Will
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>
#include "gs101-pinctrl.h"
#include "zumapro.dtsi"

/ {
	model = "Google Pixel 9 Pro (caiman)";
	compatible = "google,caiman", "google,zumapro";

	reserved-memory {
		abl_framebuffer: framebuffer@fac00000 {
			reg = <0x0 0xfac00000 0xe00000>;
			no-map;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x80000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&key_voldown>, <&key_volup>, <&key_power>;
		pinctrl-names = "default";

		button-vol-down {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&gpa4 1 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-vol-up {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&gpa6 2 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&gpa4 0 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	ufs_0_fixed_vcc_reg: regulator-1 {
		compatible = "regulator-fixed";
		regulator-name = "ufs-vcc";
		gpio = <&gpp0 1 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
		enable-active-high;
	};
};

&decon0 {
	memory-region = <&abl_framebuffer>;
	status = "okay";
};

&gpu {
	status = "okay";
};

&pinctrl_alive {
	status = "okay";

	key_power: key-power-pins {
		samsung,pins = "gpa4-0";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_UP>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	key_voldown: key-voldown-pins {
		samsung,pins = "gpa4-1";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};

	key_volup: key-volup-pins {
		samsung,pins = "gpa6-2";
		samsung,pin-function = <GS101_PIN_FUNC_EINT>;
		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
	};
};

&pinctrl_custom_alive {
	status = "okay";
};

&s2mpg14_pmic {
	regulators {
		ldo4m_ts_avdd: ldo4m {
			regulator-name = "L4M_TS_AVDD";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
		};

		ldo25m_tsp_dvdd: ldo25m {
			regulator-name = "L25M_TSP_DVDD";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
	};
};

&spi_20 {
	status = "okay";

	touchscreen@0 {
		compatible = "synaptics,s3908";
		reg = <0>;
		interrupt-parent = <&gpn0>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&gpp1 1 GPIO_ACTIVE_LOW>;
		vdd-supply = <&ldo25m_tsp_dvdd>;
		avdd-supply = <&ldo4m_ts_avdd>;
		spi-cs-setup-delay-ns = <2000>;
		spi-max-frequency = <1000000>;
	};
};

&ufs_0 {
	vcc-supply = <&ufs_0_fixed_vcc_reg>;
	status = "okay";
};

&ufs_0_phy {
	status = "okay";
};

&usi2_hsi0 {
	assigned-clocks = <&cmu_hsi0 CLK_MOUT_HSI0_USI2>;
	assigned-clock-parents = <&ext_24_5m>;
	samsung,mode = <USI_MODE_SPI>;
	status = "okay";
};
