/*
 * Google Tensor G4 (zumapro) SoC
 *
 * Copyright 2026 Will
 */

#include <dt-bindings/clock/google,zumapro.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

/ {
	compatible = "google,zumapro";
	#address-cells = <2>;
	#size-cells = <1>;

	interrupt-parent = <&gic>;

	aliases {
		pinctrl0 = &pinctrl_alive;
		pinctrl1 = &pinctrl_custom_alive;
		pinctrl2 = &pinctrl_far_alive;
		pinctrl3 = &pinctrl_gsacore0;
		pinctrl4 = &pinctrl_gsacore1;
		pinctrl5 = &pinctrl_gsacore2;
		pinctrl6 = &pinctrl_gsacore3;
		pinctrl7 = &pinctrl_gsactrl;
		pinctrl8 = &pinctrl_hsi1;
		pinctrl9 = &pinctrl_hsi2;
		pinctrl10 = &pinctrl_hsi2ufs;
		pinctrl11 = &pinctrl_peric0;
		pinctrl12 = &pinctrl_peric1;
		serial0 = &serial_0;
	};

	chosen {
		bootargs = "earlycon=exynos4210,mmio32,0x10870000 console=ttySAC0,3000000n8";
		stdout-path = "serial0:3000000n8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>; };
				core1 { cpu = <&cpu1>; };
				core2 { cpu = <&cpu2>; };
				core3 { cpu = <&cpu3>; };
			};

			cluster1 {
				core0 { cpu = <&cpu4>; };
				core1 { cpu = <&cpu5>; };
				core2 { cpu = <&cpu6>; };
			};

			cluster2 {
				core0 { cpu = <&cpu7>; };
			};
		};

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x0>;
			enable-method = "psci";
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x100>;
			enable-method = "psci";
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x200>;
			enable-method = "psci";
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x300>;
			enable-method = "psci";
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x400>;
			enable-method = "psci";
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x500>;
			enable-method = "psci";
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x600>;
			enable-method = "psci";
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-x4";
			reg = <0x700>;
			enable-method = "psci";
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	ext_24_5m: clock-24576000 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24576000>;
		clock-output-names = "oscclk";
	};

	apm_mailbox_pclk: clock-apm-mailbox {
		/* TODO(will): replace with the real CMU_APM mailbox PCLK gate */
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24576000>;
		clock-output-names = "apm_mailbox_pclk";
	};

	cmu_top: clock-controller@26040000 {
		compatible = "google,zumapro-cmu-top";
		reg = <0x0 0x26040000 0x8000>;
		#clock-cells = <1>;
		clocks = <&ext_24_5m>;
		clock-names = "oscclk";
	};

	cmu_misc: clock-controller@10010000 {
		compatible = "google,zumapro-cmu-misc";
		reg = <0x0 0x10010000 0x8000>;
		#clock-cells = <1>;
		clocks = <&ext_24_5m>, <&cmu_top CLK_DOUT_CMU_MISC_NOC>;
		clock-names = "oscclk", "bus";
	};

	cmu_peric0: clock-controller@10800000 {
		compatible = "google,zumapro-cmu-peric0";
		reg = <0x0 0x10800000 0x8000>;
		#clock-cells = <1>;
		clocks = <&ext_24_5m>,
			 <&cmu_top CLK_DOUT_CMU_PERIC0_NOC>,
			 <&cmu_top CLK_DOUT_CMU_PERIC0_IP>;
		clock-names = "oscclk", "noc", "ip";
	};

	cmu_hsi2: clock-controller@13000000 {
		compatible = "google,zumapro-cmu-hsi2";
		reg = <0x0 0x13000000 0x8000>;
		#clock-cells = <1>;
		clocks = <&ext_24_5m>,
			 <&cmu_top CLK_DOUT_CMU_HSI2_NOC>,
			 <&cmu_top CLK_DOUT_CMU_HSI2_UFS_EMBD>;
		clock-names = "oscclk", "noc", "ufs_embd";
	};

	firmware {
		acpm_ipc: power-management {
			compatible = "google,gs101-acpm-ipc";
			#clock-cells = <1>;
			mboxes = <&ap2apm_mailbox>;
			shmem = <&apm_sram>;

			s2mpg14_pmic: pmic-1 {
				compatible = "samsung,s2mpg14-pmic";
			};

			s2mpg15_pmic: pmic-2 {
				compatible = "samsung,s2mpg15-pmic";
			};
		};
	};

	apm_sram: sram@15700000 {
		compatible = "mmio-sram";
		reg = <0x0 0x15700000 0x58000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x15700000 0x58000>;
	};

	ap2apm_mailbox: mailbox@15110000 {
		compatible = "google,gs101-mbox";
		reg = <0x0 0x15110000 0x1000>;
		interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&apm_mailbox_pclk>;
		clock-names = "pclk";
		#mbox-cells = <0>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <1>;
		ranges;

		ect@90000000 {
			reg = <0x0 0x90000000 0x60000>;
		};

		gsa@90200000 {
			reg = <0x0 0x90200000 0x3ff000>;
			no-map;
		};

		gsa-log@905ff000 {
			reg = <0x0 0x905ff000 0x1000>;
			no-map;
		};

		gxp-scratchpad@91300000 {
			reg = <0x0 0x91300000 0x60000>;
			no-map;
		};

		iif-wait-table@91360000 {
			reg = <0x0 0x91360000 0x20000>;
			no-map;
		};

		iif-signal-table@91380000 {
			reg = <0x0 0x91380000 0x20000>;
			no-map;
		};

		gxp-secure-data@91400000 {
			reg = <0x0 0x91400000 0x900000>;
			no-map;
		};

		gxp-fw@91d00000 {
			reg = <0x0 0x91d00000 0x300000>;
			no-map;
		};

		gxp-mcu-fw@92000000 {
			reg = <0x0 0x92000000 0x400000>;
			no-map;
		};

		tpu-fw@92e00000 {
			reg = <0x0 0x92e00000 0x1200000>;
			no-map;
		};

		aoc@94000000 {
			reg = <0x0 0x94000000 0x3000000>;
			no-map;
		};

		pkvm_guest_firmware: pkvm-guest-firmware@b5000000 {
			compatible = "linux,pkvm-guest-firmware-memory";
			reg = <0x0 0xb5000000 0xd0000>;
			no-map;
		};

		seclog@c3000000 {
			reg = <0x0 0xc3000000 0x80000>;
		};

		dss-header@d8100000 {
			reg = <0x0 0xd8100000 0x10000>;
			no-map;
		};

		dss-log-kevents@d8110000 {
			reg = <0x0 0xd8110000 0x700000>;
			no-map;
		};

		dss-log-s2d@d8810000 {
			reg = <0x0 0xd8810000 0x1800000>;
			no-map;
		};

		dss-log-array-reset@da010000 {
			reg = <0x0 0xda010000 0xa00000>;
			no-map;
		};

		dss-log-itmon@dda10000 {
			reg = <0x0 0xdda10000 0x10000>;
			no-map;
		};

		dss-log-s2d-extract@dda20000 {
			reg = <0x0 0xdda20000 0x600000>;
			no-map;
		};

		abl@f8800000 {
			reg = <0x0 0xf8800000 0x1000000>;
			no-map;
		};

		dss-log@fd3f0000 {
			reg = <0x0 0xfd3f0000 0xe000>;
			no-map;
		};

		debug-kinfo@fd3fe000 {
			reg = <0x0 0xfd3fe000 0x1000>;
			no-map;
		};

		bldr-log@fd800000 {
			reg = <0x0 0xfd800000 0x100000>;
			no-map;
		};

		abl-log-hist@fd900000 {
			reg = <0x0 0xfd900000 0x2000>;
			no-map;
		};

		pbl-log@fd90a000 {
			reg = <0x0 0xfd90a000 0x2000>;
			no-map;
		};

		bl31-log@fd930000 {
			reg = <0x0 0xfd930000 0x10000>;
			no-map;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts =
		   <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
		   <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
		   <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>,
		   <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW) 0>;
	};

	gic: interrupt-controller@10400000 {
		compatible = "arm,gic-v3";
		#address-cells = <0>;
		#interrupt-cells = <4>;
		interrupt-controller;
		reg = <0x0 0x10400000 0x10000>,		/* GICD */
		      <0x0 0x10440000 0x200000>;	/* GICR * 8 */
		interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	watchdog_cl0: watchdog@10060000 {
		compatible = "google,zuma-cl0-wdt";
		reg = <0x0 0x10060000 0x100>;
	};

	watchdog_cl1: watchdog@10070000 {
		compatible = "google,zuma-cl1-wdt";
		reg = <0x0 0x10070000 0x100>;
	};

	serial_0: uart@10870000 {
		compatible = "samsung,exynos-uart";
		reg = <0x0 0x10870000 0x100>;
		reg-io-width = <4>;
		interrupts = <GIC_SPI 641 IRQ_TYPE_LEVEL_HIGH 0>;
		clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI0_UART_PCLK>,
			 <&cmu_peric0 CLK_GOUT_PERIC0_USI0_UART_IPCLK>;
		clock-names = "uart", "clk_uart_baud0";
	};

	pinctrl_alive: pinctrl@154d0000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x154d0000 0x1000>;
		status = "disabled";
	};

	pinctrl_custom_alive: pinctrl@15060000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x15060000 0x1000>;
		status = "disabled";
	};

	pinctrl_far_alive: pinctrl@154e0000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x154e0000 0x1000>;
		status = "disabled";
	};

	pinctrl_gsacore0: pinctrl@16280000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x16280000 0x1000>;
		status = "disabled";
	};

	pinctrl_gsacore1: pinctrl@16290000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x16290000 0x1000>;
		status = "disabled";
	};

	pinctrl_gsacore2: pinctrl@162a0000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x162a0000 0x1000>;
		status = "disabled";
	};

	pinctrl_gsacore3: pinctrl@162b0000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x162b0000 0x1000>;
		status = "disabled";
	};

	pinctrl_gsactrl: pinctrl@16140000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x16140000 0x1000>;
		status = "disabled";
	};

	pinctrl_hsi1: pinctrl@12040000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x12040000 0x1000>;
		interrupts = <GIC_SPI 413 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	pinctrl_hsi2: pinctrl@13040000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x13040000 0x1000>;
		interrupts = <GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	pinctrl_hsi2ufs: pinctrl@13060000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x13060000 0x1000>;
		interrupts = <GIC_SPI 433 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	pinctrl_peric0: pinctrl@10840000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x10840000 0x1000>;
		interrupts = <GIC_SPI 634 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	pinctrl_peric1: pinctrl@10c40000 {
		compatible = "google,zumapro-pinctrl";
		reg = <0x0 0x10c40000 0x1000>;
		interrupts = <GIC_SPI 649 IRQ_TYPE_LEVEL_HIGH 0>;
	};
};

#include "zumapro-pinctrl.dtsi"
